{
  "name": "knight-trader-coinbase",
  "version": "1.0.0",
  "description": "KnightTrader Coinbase — Hermes credential manager & launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.knighttrader.coinbase",
    "productName": "KnightTrader Coinbase",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "publish": {
      "provider": "github",
      "owner": "mknight2690-sys",
      "repo": "knighttrader-coinbase",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "eventsource": "^5.1.0",
    "jose": "^6.2.8",
    "node-cron": "^3.0.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "keywords": [
    "electron",
    "trading",
    "hermes",
    "coinbase"
  ],
  "author": "KnightTrader",
  "license": "MIT",
  "allowScripts": {
    "electron@28.3.3": true
  }
}
