{
  "name": "knight-trader-propr",
  "version": "2.0.18",
  "description": "KnightTrader Propr — Hermes credential manager & launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-builder",
    "build:win": "electron-builder --win --publish always",
    "build:mac": "electron-builder --mac --publish always",
    "build:linux": "electron-builder --linux --publish always"
  },
  "build": {
    "appId": "com.knighttrader.propr",
    "productName": "KnightTrader Propr",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.jpg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.jpg",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "executableName": "knighttrader-propr",
      "icon": "assets/icon.png",
      "category": "Finance",
      "maintainer": "KnightTrader <support@knighttrader.local>",
      "synopsis": "Hermes + Propr challenge auto-trading launcher",
      "description": "KnightTrader Propr desktop app — Hermes credentials, dashboard, gateway, and Propr cron."
    },
    "extraFiles": [
      {
        "from": "scripts/run-linux.sh",
        "to": "run-knighttrader-propr.sh"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mknight2690-sys",
      "repo": "knighttrader-coinbase",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "eventsource": "^5.1.0",
    "jose": "^6.2.8",
    "node-cron": "^3.0.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "keywords": [
    "electron",
    "trading",
    "hermes",
    "propr"
  ],
  "author": "KnightTrader",
  "license": "MIT",
  "allowScripts": {
    "electron@28.3.3": true
  }
}
